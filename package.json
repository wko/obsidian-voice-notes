{
  "name": "obsidian-voice-append",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --watch",
    "release": "tsc --noEmit && node build.mjs --release",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run release",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "description": "Record, transcribe, clean up, and append thoughts to the active Obsidian note.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wko/obsidian-voice-notes.git"
  },
  "bugs": {
    "url": "https://github.com/wko/obsidian-voice-notes/issues"
  },
  "homepage": "https://github.com/wko/obsidian-voice-notes#readme",
  "keywords": [
    "obsidian",
    "voice",
    "transcription",
    "openai"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
